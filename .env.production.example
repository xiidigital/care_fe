# Public build-time configuration for the CARE production frontend.
# Copy to .env.production.local before building. The copied file is ignored.

REACT_APP_TITLE=CARE
REACT_APP_META_DESCRIPTION="CARE clinical information system"
REACT_APP_COVER_IMAGE=https://cdn.ohc.network/care_logo.svg
REACT_APP_COVER_IMAGE_ALT=https://cdn.ohc.network/care_logo.svg

REACT_PUBLIC_URL=https://care-prod-jsgaviota-2608.web.app
REACT_CARE_API_URL=https://care-prod-api-3pm2amdrsa-uc.a.run.app
REACT_SBOM_BASE_URL=https://sbom.ohc.network

# Keep patient login disabled until an approved reCAPTCHA key and end-to-end
# authentication verification exist for the production domains.
REACT_RECAPTCHA_SITE_KEY=
REACT_DISABLE_PATIENT_LOGIN=true

REACT_ALLOWED_LOCALES=en
REACT_DEFAULT_COUNTRY=MX
REACT_DEFAULT_COUNTRY_NAME=Mexico
REACT_ENABLED_APPS=
REACT_APP_STORE_INDEX_URL=https://raw.githubusercontent.com/ohcnetwork/care_apps_registry/refs/heads/main/index.json

# Telemetry is opt-in. Uncomment both values only after processor and PHI review.
# REACT_SENTRY_DSN=https://examplePublicKey@example.ingest.sentry.io/exampleProject
# REACT_SENTRY_ENVIRONMENT=production

REACT_INJECTED_HEAD=""
REACT_INJECTED_HTML=""
